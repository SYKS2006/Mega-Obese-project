# ข้อมูลเชื่อมต่อ PostgreSQL (ดูได้จาก pgAdmin → คลิกขวาที่ server → Properties → Connection)
PGHOST=localhost
PGPORT=5432
PGDATABASE=northwind
PGUSER=postgres
PGPASSWORD=ใส่รหัสผ่าน_postgres_ของคุณ

# พอร์ตของ API (หน้าเว็บจะเปิดที่ http://localhost:3000)
PORT=3000

# คีย์ลับสำหรับสร้าง token ตอน login (เปลี่ยนเป็นข้อความอะไรก็ได้ยาว ๆ)
JWT_SECRET=mega-obese-change-this-secret

# เขตเวลาที่ใช้ลงวันที่/เวลาในบิล
STORE_TZ=Asia/Bangkok

# บันทึกออเดอร์ใหม่ลงตาราง "db_7-11" เดิมด้วย (true = เปิด, false = ปิด)
DB711_SYNC=true
DB711_TABLE=public."db_7-11"
